{
  "name": "traceguard-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && vitest run",
    "test:unit": "node --test src/features/lineage/*.test.ts src/features/investigation/*.test.ts src/lib/api/*.test.ts src/lib/fixtures/*.test.ts",
    "test:checkpoints": "node check-integration.mjs"
  },
  "dependencies": {
    "@xyflow/react": "13.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
